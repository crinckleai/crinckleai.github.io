rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for players + match feed; writes go through Cloud Functions.
    match /players/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /matches/{matchId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /gameweeks/{gw}/feed/{event} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Each manager owns their squads.
    match /managers/{managerId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == managerId;
    }
  }
}
